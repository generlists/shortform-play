<?xml version="1.0" encoding="utf-8"?>
<!--Android 12+에서 SplashScreen API가 MainActivity에 자동 적용-->
<resources>
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/black</item>
<!--        <item name="windowSplashScreenAnimatedIcon">@drawable/shortform_play_icon_main</item>-->
        <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="windowSplashScreenAnimationDuration">2000</item>  <!-- AVD duration과 맞춤 -->

        <item name="postSplashScreenTheme">@style/Theme.App.MyApp</item>
        <item name="android:windowBackground">@color/black</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
<!--       -->

    </style>

</resources>