<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Launcher 테마: SplashScreen API 사용 (모든 버전 공통) -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Android 12+ 필수: 배경 색상 (상태바/네비바도 이 색 따라감) -->
        <item name="windowSplashScreenBackground">@color/black</item>

        <!-- 아이콘: 당신 앱 아이콘 foreground 추천 (adaptive icon) -->
        <item name="windowSplashScreenAnimatedIcon">@color/black</item>  <!-- sym_def_app_icon 대신 -->

        <!-- 아이콘 뒤 배경 (투명 원함) -->
        <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>

        <!-- 애니메이션 시간: 0이면 즉시 끝남 → 300~500ms 추천 -->
        <item name="windowSplashScreenAnimationDuration">2000</item>

        <!-- Splash 끝난 후 실제 앱 테마 -->
        <item name="postSplashScreenTheme">@style/Theme.App.MyApp</item>

        <!-- 레거시 fallback: Android 11 이하에서 이게 windowBackground로 사용됨 -->
        <!-- drawable이면 풀 이미지 가능, 여기서는 색상만 -->
        <item name="android:windowBackground">@color/black</item>

        <!-- 상태바 관련 (12+는 windowSplashScreenBackground 따라가지만 안전하게) -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- 상태바 아이콘 밝게 (흰색) -->
        <item name="android:windowLightStatusBar">true</item>

        <!-- 풀스크린 시도지만 12+ 무시됨 -->
        <item name="android:windowFullscreen">true</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- 실제 앱 테마 (Splash 후 적용) -->
    <style name="Theme.App.MyApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowFullscreen">false</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/main_background</item>
        <item name="android:navigationBarColor">@color/main_background</item>
<!--        <item name="mediaRouteTheme">@style/ThemeOverlay.AppCompat.Dark</item>-->
        <!-- 다른 속성들... -->
    </style>

</resources>